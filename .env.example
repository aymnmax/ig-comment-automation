# ---- Supabase ----
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role key is ONLY used on the server (webhook handler). Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Meta / Facebook App (used for Instagram Graph API, separate from Supabase Google login) ----
META_APP_ID=your-facebook-app-id
META_APP_SECRET=your-facebook-app-secret
# Must exactly match the redirect URI you whitelist in the Meta App dashboard
META_REDIRECT_URI=https://your-vercel-domain.vercel.app/api/instagram/callback

# ---- Webhook ----
# Any random string you invent. You'll type this same value into the Meta webhook config.
IG_VERIFY_TOKEN=choose-any-random-string

# ---- App ----
NEXT_PUBLIC_APP_URL=https://your-vercel-domain.vercel.app
